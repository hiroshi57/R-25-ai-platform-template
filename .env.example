# =============================================================================
# ai-platform-template 環境変数サンプル
# `cp .env.example .env` して値を埋める(.env は .gitignore 済み)
# =============================================================================

# --- 認証(必須) -------------------------------------------------------------
# 形式: "key1:tenantA,key2:tenantB"
# 【重要】旧サンプルは "demo-key:demo-tenant" を例示し、かつアプリ側が
# demo-key を無条件登録していたため、本番でも常に通るバックドアになっていた。
# 必ず下記コマンドで生成した高エントロピーなキーを使うこと:
#   python -c "from core import generate_api_key; print(generate_api_key())"
AI_PLATFORM_API_KEYS=

# ローカル開発時のみ 1 にすると、既知のデモキーが自動登録される。
# 本番では絶対に設定しないこと。
AI_PLATFORM_DEV_MODE=0

# --- 実プロバイダ接続(未設定なら mock で動作) -------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- ルーティング -------------------------------------------------------------
# cost / latency / quality / balanced
AI_PLATFORM_STRATEGY=balanced
AI_PLATFORM_PROVIDERS=claude,openai,gemini
AI_PLATFORM_PROVIDER_TIMEOUT_SEC=30
AI_PLATFORM_PROVIDER_MAX_RETRIES=1

# --- 単価カタログ -------------------------------------------------------------
# 同梱の既定単価は一次情報で未検証の初期値。実単価は JSON で注入する。
# 形式: [{"name":"claude","model":"...","cost_per_1k_input":0.003,
#         "cost_per_1k_output":0.015,"key_env":"ANTHROPIC_API_KEY","verified":true}]
AI_PLATFORM_PRICING_FILE=

# --- 永続化 -------------------------------------------------------------------
# ":memory:" にするとプロセス終了でコスト履歴が消える(FinOps が成立しない)
AI_PLATFORM_DB_PATH=ai_platform.db

# --- FinOps -------------------------------------------------------------------
# 0 なら予算ガード無効。>0 にすると着地見込み超過時に cost 戦略へ自動降格。
AI_PLATFORM_MONTHLY_BUDGET_USD=0

# --- レート制限 ---------------------------------------------------------------
# 注意: プロセスローカル。複数インスタンスで動かすと実効上限は台数倍になる。
AI_PLATFORM_RATE_CAPACITY=20
AI_PLATFORM_RATE_REFILL=5

# --- ロギング -----------------------------------------------------------------
AI_PLATFORM_LOG_LEVEL=INFO
AI_PLATFORM_LOG_JSON=true

# --- CORS ---------------------------------------------------------------------
# frontend(Vite dev)からアクセスする場合に必要
AI_PLATFORM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- スケジュール通達(POST /v1/notify/scheduled)-----------------------------
# 任意テキストを Teams と Chatwork へ同報する。外部スケジューラ(Cloud Scheduler /
# cron 等)がエンドポイントを叩く運用を想定。未設定のチャネルは自動で no-op。
# Teams: Incoming Webhook の URL
TEAMS_WEBHOOK_URL=
# Chatwork: API トークンと投稿先ルームID(両方揃って初めて有効)
CHATWORK_API_TOKEN=
CHATWORK_ROOM_ID=
# 1 送信あたりのタイムアウト秒数(既定 10)
AI_PLATFORM_NOTIFY_TIMEOUT_SEC=10
